<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_HELLO_NAME</name>
	<version>1.0.0</version>
	<author>Dev</author>
	<creationDate>2026-10</creationDate>
	<description>MOD_HELLO_DESCRIPTION</description>
	<namespace path="src">Dev\Module\Hello</namespace>
	<files>
		<folder module="mod_hello">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_hello.ini</language>
		<language tag="en-GB">language/en-GB/mod_hello.sys.ini</language>
		<language tag="pl-PL">language/pl-PL/mod_hello.ini</language>
		<language tag="pl-PL">language/pl-PL/mod_hello.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="greeting"
					type="text"
					label="MOD_HELLO_FIELD_GREETING_LABEL"
					description="MOD_HELLO_FIELD_GREETING_DESC"
					default="Hello"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
