<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>PLG_SYSTEM_HELLO</name>
	<version>1.0.0</version>
	<author>Dev</author>
	<creationDate>2026-10</creationDate>
	<description>PLG_SYSTEM_HELLO_DESCRIPTION</description>
	<namespace path="src">Dev\Plugin\System\Hello</namespace>
	<files>
		<folder plugin="hello">services</folder>
		<folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_system_hello.ini</language>
		<language tag="en-GB">language/en-GB/plg_system_hello.sys.ini</language>
		<language tag="pl-PL">language/pl-PL/plg_system_hello.ini</language>
		<language tag="pl-PL">language/pl-PL/plg_system_hello.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="enabled_message"
					type="radio"
					label="PLG_SYSTEM_HELLO_FIELD_MESSAGE_LABEL"
					description="PLG_SYSTEM_HELLO_FIELD_MESSAGE_DESC"
					default="0"
					layout="joomla.form.field.radio.switcher"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
